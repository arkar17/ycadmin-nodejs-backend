# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Authentication (placeholder only; replace locally with a secret of at least 32 characters)
JWT_SECRET=replace-with-a-local-development-secret-at-least-32-characters
JWT_EXPIRES_IN=30d

# Database (placeholder only; this project does not connect during initialization)
DATABASE_URL=postgresql://username:password@localhost:5432/yc_fitness?schema=public

# Permanent attendance QR credential keys. Store only local/dev placeholders here;
# obtain production material from the approved secret manager. Each must be
# canonical base64. Encryption decodes to exactly 32 bytes; HMAC to >= 32 bytes.
ATTENDANCE_QR_ENCRYPTION_KEY=
ATTENDANCE_QR_HMAC_KEY=

# Payment push (FCM). Disabled by default; no Firebase SDK is loaded while false.
# Never commit service-account JSON. Inject FIREBASE_SERVICE_ACCOUNT_JSON_BASE64 from
# the deployment secret manager. Do NOT copy the Mobile API's credential file.
PAYMENT_PUSH_ENABLED=false
# service_account | application_default
FIREBASE_CREDENTIAL_SOURCE=service_account
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# Required for application_default; optional cross-check for service_account.
FIREBASE_PROJECT_ID=
# 500-15000
PAYMENT_PUSH_TIMEOUT_MS=5000
